{
  "schemaVersion": 1,
  "target": {
    "codexVersion": "0.144.1",
    "platform": "darwin",
    "architecture": "arm64",
    "osVersion": "15.6",
    "captureDate": "2026-07-14"
  },
  "supportPolicy": {
    "kind": "exact-tested",
    "versions": [
      "0.144.1"
    ]
  },
  "officialSources": [
    "https://learn.chatgpt.com/docs/config-file/config-advanced#custom-model-providers",
    "https://developers.openai.com/api/docs/guides/streaming-responses"
  ],
  "stateMode": "full-input",
  "modelCatalog": {
    "topLevelField": "models",
    "nonEmpty": true,
    "openAiDataShapeAccepted": false,
    "fallbackMetadataAllowed": false,
    "itemRequiredFields": [
      "slug",
      "display_name",
      "supported_reasoning_levels",
      "shell_type",
      "visibility",
      "supported_in_api",
      "priority",
      "base_instructions",
      "supports_reasoning_summaries",
      "support_verbosity",
      "truncation_policy",
      "supports_parallel_tool_calls",
      "experimental_supported_tools"
    ]
  },
  "requiredRouteSet": [
    "GET /v1/models",
    "POST /v1/responses"
  ],
  "observedRouteSet": [
    "GET /v1/models",
    "POST /v1/responses"
  ],
  "volatileFields": [
    "$.body.client_metadata.session_id",
    "$.body.client_metadata.thread_id",
    "$.body.client_metadata.turn_id",
    "$.body.client_metadata.x-codex-installation-id",
    "$.body.client_metadata.x-codex-turn-metadata",
    "$.body.client_metadata.x-codex-window-id",
    "$.body.prompt_cache_key",
    "$.body.input generated context text",
    "$.body.instructions",
    "$.body.tools non-representative schemas",
    "response and item IDs",
    "temporary root and loopback port",
    "timestamps and command timing"
  ],
  "scenarios": [
    {
      "id": "text-stream",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "Codex sent stream=true to POST /v1/responses and accepted the normalized semantic SSE lifecycle through response.completed.",
      "artifacts": [
        "normal/text-stream-request.json",
        "normal/text-stream-events.json",
        "observations/model-catalog.json",
        "observations/determinism.json"
      ]
    },
    {
      "id": "text-non-stream",
      "status": "unsupported",
      "runs": 2,
      "deterministic": true,
      "evidence": "Every text, tool, and resume request emitted by codex exec 0.144.1 used stream=true; no non-stream CLI path was observed.",
      "artifacts": []
    },
    {
      "id": "function-tool",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "The follow-up request replayed full input including function_call and function_call_output with previous_response_id=null.",
      "artifacts": [
        "normal/function-tool-initial-request.json",
        "normal/function-tool-followup-request.json",
        "normal/function-tool-events.json",
        "observations/normal.json"
      ]
    },
    {
      "id": "resume",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "A persisted temporary session resumed by replaying full first-turn user and assistant items plus the new user item; previous_response_id remained null.",
      "artifacts": [
        "normal/resume-initial-request.json",
        "normal/resume-request.json",
        "normal/resume-events.json",
        "observations/normal.json"
      ]
    },
    {
      "id": "route-inventory",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "Normal and failure cases observed only GET /v1/models and POST /v1/responses; retrieve and cancel routes were not called.",
      "artifacts": [
        "observations/route-inventory.json"
      ]
    },
    {
      "id": "auth-helper-trim",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "The helper received zero stdin bytes; surrounding whitespace was trimmed and requests carried the expected bearer value before redaction.",
      "artifacts": [
        "observations/auth-helper.json"
      ]
    },
    {
      "id": "auth-helper-empty",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "Codex reported an empty-token error but still sent three unauthenticated requests and completed because the capture server accepted them.",
      "artifacts": [
        "observations/auth-helper.json"
      ]
    },
    {
      "id": "auth-refresh-401",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "A first 401 caused one helper refresh and one replay; the second Responses request completed successfully.",
      "artifacts": [
        "observations/auth-helper.json",
        "observations/failure-determinism.json"
      ]
    },
    {
      "id": "retry-429",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "A 429 with Retry-After 0 produced one Responses attempt and a terminal Codex error.",
      "artifacts": [
        "observations/retries.json"
      ]
    },
    {
      "id": "retry-500",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "Default request and stream retry layers produced 30 Responses attempts before a terminal Codex error.",
      "artifacts": [
        "observations/retries.json"
      ]
    },
    {
      "id": "malformed-sse",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "A malformed SSE payload produced six Responses attempts before a terminal Codex error.",
      "artifacts": [
        "observations/retries.json"
      ]
    },
    {
      "id": "disconnect",
      "status": "captured",
      "runs": 2,
      "deterministic": true,
      "evidence": "Killing the isolated Codex process group after response.created closed the client connection observed by the server.",
      "artifacts": [
        "observations/disconnect.json"
      ]
    }
  ],
