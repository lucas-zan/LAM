{
  "name": "@localagentmanager/desktop",
  "version": "0.3.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:gateway-phase0": "node --test scripts/capture-codex-contract.test.mjs scripts/verify-remote-provider-gateway-phase0.test.mjs && node scripts/verify-remote-provider-gateway-phase0.mjs",
    "test:gateway-g5": "node --test scripts/verify-provider-gateway-g5.test.mjs && node scripts/verify-provider-gateway-g5.mjs",
    "tauri:dev": "node scripts/package-gateway-components.mjs dev && tauri dev",
    "package:gateway-components": "node scripts/package-gateway-components.mjs prepare",
    "verify:gateway-components": "node scripts/package-gateway-components.mjs verify",
    "package:gateway-finalize": "node scripts/package-gateway-components.mjs finalize",
    "package:gateway-dmg": "node scripts/package-gateway-components.mjs dmg",
    "tauri:build": "npm run package:gateway-components && tauri build --bundles app --config src-tauri/tauri.gateway.conf.json && npm run package:gateway-finalize",
    "tauri:dmg": "npm run tauri:build && npm run package:gateway-dmg",
    "icons": "tauri icon src-tauri/icons/icon.svg -o src-tauri/icons",
    "tauri": "tauri",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
